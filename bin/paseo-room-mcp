def fail(message: str) -> None:
    print(message, file=sys.stderr, flush=True)
    raise SystemExit(1)


def resolve_agent_id() -> str:
    direct = os.environ.get("PASEO_AGENT_ID", "").strip()
    if direct:
        return direct

    # Codex intentionally filters most parent environment variables before
    # launching stdio MCP servers. Paseo still places PASEO_AGENT_ID on the
    # role's Codex app-server process, so walk same-user parent processes and
    # recover only that one non-secret identity field.
    pid = os.getppid()
    for _ in range(8):
        if pid <= 1:
            break
        try:
            process = subprocess.run(
                ["ps", "eww", "-p", str(pid), "-o", "command="],
                capture_output=True,
                text=True,
                check=True,
                timeout=3,
            )
            match = re.search(r"(?:^|\s)PASEO_AGENT_ID=([^\s]+)", process.stdout)
            if match:
                return match.group(1)
            parent = subprocess.run(
                ["ps", "-p", str(pid), "-o", "ppid="],
                capture_output=True,
                text=True,
                check=True,
                timeout=3,
            ).stdout.strip()
            pid = int(parent)
        except (OSError, ValueError, subprocess.SubprocessError):
            break
    return ""


def read_message() -> dict[str, Any] | None:
    first = sys.stdin.buffer.readline()
    if not first:
        return None
    if first.lower().startswith(b"content-length:"):
        try:
            length = int(first.split(b":", 1)[1].strip())
        except ValueError:
            fail("Invalid MCP Content-Length header")
        while True:
            header = sys.stdin.buffer.readline()
            if header in (b"\n", b"\r\n", b""):
                break
        raw = sys.stdin.buffer.read(length)
    else:
        raw = first.strip()
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as error:
        fail(f"Invalid MCP JSON: {error}")
    if not isinstance(value, dict):
        fail("MCP message must be a JSON object")
    return value


def write_message(value: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def error_response(request_id: Any, code: int, message: str) -> dict[str, Any]:
    return {
        "jsonrpc": "2.0",
        "id": request_id,
        "error": {"code": code, "message": message},
    }


def denied_tool_result(request_id: Any, reason: str) -> dict[str, Any]:
    return {
        "jsonrpc": "2.0",
        "id": request_id,
        "result": {
            "content": [{"type": "text", "text": f"Room authority denied: {reason}"}],
            "isError": True,
        },
    }


def text_tool_result(
    request_id: Any,
    text: str,
    *,
    is_error: bool = False,
) -> dict[str, Any]:
    return {
        "jsonrpc": "2.0",
        "id": request_id,
        "result": {
            "content": [{"type": "text", "text": text}],
            "isError": is_error,
        },
    }


def load_agent_record(agent_id: str) -> dict[str, Any] | None:
    if not AGENT_ID_PATTERN.fullmatch(agent_id):
        return None
    matches = list(AGENTS_ROOT.glob(f"*/{agent_id}.json"))
    if len(matches) != 1:
        return None
    try:
        value = json.loads(matches[0].read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) and value.get("id") == agent_id else None


def agent_record_status(agent_id: str) -> tuple[str, dict[str, Any] | None]:
    record = load_agent_record(agent_id)
    if isinstance(record, dict):
        return ("archived" if record.get("archivedAt") else "active"), record
    if not AGENT_ID_PATTERN.fullmatch(agent_id):
        return "missing", None
    matches = list(AGENTS_ROOT.glob(f"*/{agent_id}.json"))
    return ("unreadable" if matches else "missing"), None


def iter_agent_records() -> list[dict[str, Any]]:
    records = []
    for path in sorted(AGENTS_ROOT.glob("*/*.json")):
        try:
            value = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if (
            isinstance(value, dict)
            and isinstance(value.get("id"), str)
            and AGENT_ID_PATTERN.fullmatch(value["id"])
        ):
            records.append(value)
    return records


def workspace_lifecycle(workspace_id: str) -> str:
    try:
        records = json.loads(WORKSPACES_PATH.read_text())
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return "unreadable"
    if not isinstance(records, list):
        return "unreadable"
    for record in records:
        if isinstance(record, dict) and record.get("workspaceId") == workspace_id:
            return "archived" if record.get("archivedAt") else "active"
    return "missing"


def structured_content(response: Any) -> dict[str, Any] | None:
    if not isinstance(response, dict):
        return None
    result = response.get("result")
    if not isinstance(result, dict) or result.get("isError") is True:
        return None
    value = result.get("structuredContent")
    return value if isinstance(value, dict) else None


def digest_payload(value: Any) -> str:
    payload = json.dumps(value, separators=(",", ":"), sort_keys=True).encode()
    return f"sha256:{hashlib.sha256(payload).hexdigest()}"


def write_json_atomic(path: pathlib.Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def utc_timestamp() -> str:
    return dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")


def append_history(
    lease: dict[str, Any],
    operation: str,
    actor_id: str,
    authority_class: str,
    correlation_id: str,
    result: str,
) -> None:
    """Append evidence only; the lease registry remains lifecycle authority."""
    event = {
        "work_epoch": lease.get("work_epoch"),
        "revision": lease.get("revision"),
        "operation": operation,
        "actor_id": actor_id,
        "authority_class": authority_class,
        "timestamp": utc_timestamp(),
        "correlation_id": correlation_id,
        "result": result,
        "uncertain": result == "UNCERTAIN",
    }
    HISTORY_PATH.parent.mkdir(parents=True, exist_ok=True)
    data = (json.dumps(event, separators=(",", ":"), sort_keys=True) + "\n").encode()
    descriptor = os.open(HISTORY_PATH, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        written = os.write(descriptor, data)
        if written != len(data):
            raise OSError("short append to SLP decision history")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def evidence_digest(epoch: int, message: str) -> str:
    payload = json.dumps(
        {"handback_message": message, "work_epoch": epoch},
        separators=(",", ":"),
        sort_keys=True,
    ).encode()
    return f"sha256:{hashlib.sha256(payload).hexdigest()}"


def normalize_lease_revision(lease: dict[str, Any]) -> int:
    revision = lease.get("revision", 1)
    if not isinstance(revision, int) or isinstance(revision, bool) or revision < 1:
        raise RuntimeError("Managed lease revision is invalid; failing closed")
    lease["revision"] = revision
    return revision


def bump_revision(lease: dict[str, Any]) -> int:
    revision = normalize_lease_revision(lease) + 1
    lease["revision"] = revision
    return revision


def expected_version_matches(
    lease: dict[str, Any], expected_epoch: Any, expected_revision: Any
) -> bool:
    return (
        isinstance(expected_epoch, int)
        and isinstance(expected_revision, int)
        and lease.get("work_epoch") == expected_epoch
        and normalize_lease_revision(lease) == expected_revision
    )


def reserve_prior_evidence(lease: dict[str, Any]) -> None:
    for key in ("candidate_digest", "candidate_reviews"):
        if key in lease:
            lease["prior_" + key] = lease.pop(key)
    if "evidence_digest" in lease:
        lease["prior_evidence_digest"] = lease.pop("evidence_digest")
    if "legacy_evidence_missing" in lease:
        lease["prior_legacy_evidence_missing"] = lease.pop("legacy_evidence_missing")


def restore_prior_evidence(lease: dict[str, Any]) -> None:
    for key in ("candidate_digest", "candidate_reviews"):
        if "prior_" + key in lease:
            lease[key] = lease.pop("prior_" + key)
    if "prior_evidence_digest" in lease:
        lease["evidence_digest"] = lease.pop("prior_evidence_digest")
    if "prior_legacy_evidence_missing" in lease:
        lease["legacy_evidence_missing"] = lease.pop("prior_legacy_evidence_missing")


def discard_prior_evidence(lease: dict[str, Any]) -> None:
    for key in ("candidate_digest", "candidate_reviews"):
        lease.pop("prior_" + key, None)
    lease.pop("prior_evidence_digest", None)
    lease.pop("prior_legacy_evidence_missing", None)


def validate_lease_entry(workspace_id: Any, lease: Any) -> dict[str, Any]:
    if not isinstance(workspace_id, str) or not workspace_id:
        raise RuntimeError("Lead lease registry has an invalid workspace key; failing closed")
    if not isinstance(lease, dict):
        raise RuntimeError(f"Lead lease {workspace_id} is not an object; failing closed")
    stored_workspace = lease.get("workspace_id")
    if stored_workspace is not None and stored_workspace != workspace_id:
        raise RuntimeError(f"Lead lease {workspace_id} has mismatched workspace authority")
    state = lease.get("state")
    if state is not None and not isinstance(state, str):
        raise RuntimeError(f"Lead lease {workspace_id} has invalid state; failing closed")
    normalize_lease_revision(lease)
    return lease


@contextlib.contextmanager
def locked_leases():
    LEASES_PATH.parent.mkdir(parents=True, exist_ok=True)
    lock_path = LEASES_PATH.with_suffix(LEASES_PATH.suffix + ".lock")
    with lock_path.open("a+") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        try:
            try:
                value = json.loads(LEASES_PATH.read_text())
            except FileNotFoundError:
                value = {"version": 2, "leases": {}}
            except (OSError, json.JSONDecodeError) as error:
                raise RuntimeError("Lead lease registry is unreadable; failing closed") from error
            if not isinstance(value, dict):
                raise RuntimeError("Lead lease registry is not an object; failing closed")
            old_version = value.get("version", 1)
            value["version"] = 2
            if not isinstance(value.get("leases"), dict):
                raise RuntimeError("Lead lease registry has invalid leases; failing closed")
            for workspace_id, lease in value["leases"].items():
                validate_lease_entry(workspace_id, lease)
            if isinstance(old_version, int) and old_version < 2:
                for lease in value["leases"].values():
                    lease.setdefault("room_kind", "managed_slp")
                    lease.setdefault("work_epoch", 1)
                    lease.setdefault("handback_epoch", 0)
                    lease.setdefault("decision_state", "WORKING")
                    lease.setdefault("legacy_epoch_unknown", True)
            for lease in value["leases"].values():
                normalize_lease_revision(lease)
            yield value
            write_json_atomic(LEASES_PATH, value)
        finally:
            fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)


@contextlib.contextmanager
def read_locked_leases():
    """Read a current registry under the writer's lock without touching its bytes."""
    lock_path = LEASES_PATH.with_suffix(LEASES_PATH.suffix + ".lock")
    try:
        with lock_path.open("r") as lock_stream:
            fcntl.flock(lock_stream.fileno(), fcntl.LOCK_SH)
            try:
                value = json.loads(LEASES_PATH.read_text())
                if (
                    not isinstance(value, dict)
                    or value.get("version") != 2
                    or not isinstance(value.get("leases"), dict)
                ):
                    raise RuntimeError("Lead lease registry requires current version 2 shape")
                for workspace_id, lease in value["leases"].items():
                    if (
                        not isinstance(workspace_id, str) or not workspace_id
                        or not isinstance(lease, dict)
                        or lease.get("workspace_id") != workspace_id
                        or lease.get("room_kind") != "managed_slp"
                        or lease.get("state") not in {"active", "released"}
                        or type(lease.get("work_epoch")) is not int
                        or lease["work_epoch"] < 1
                        or type(lease.get("revision")) is not int
                        or lease["revision"] < 1
                        or not isinstance(lease.get("decision_state"), str)
                    ):
                        raise RuntimeError("Lead lease registry contains a legacy or invalid entry")
                yield value
            finally:
                fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    except (FileNotFoundError, OSError, json.JSONDecodeError) as error:
        raise RuntimeError("Lead lease registry is unreadable; failing closed") from error


def lead_lease(registry: dict[str, Any], lead_id: str) -> dict[str, Any] | None:
    for lease in registry["leases"].values():
        if (
            isinstance(lease, dict)
            and lease.get("state") == "active"
            and lease.get("lead_agent_id") == lead_id
            and lease.get("room_kind") == "managed_slp"
        ):
            return lease
    return None


def bind_root_lead(lead_id: str, supervisor_id: str | None, task_class: str, *, apply: bool = False) -> dict[str, Any]:
    """Human adoption, never agent creation or reparenting."""
    lead = load_agent_record(lead_id)
    if not lead or lead.get("archivedAt") or lead.get("provider") not in CUSTOM_LEAD_PROVIDERS:
        raise workflow.WorkflowError("Binding requires an active role-aware Lead provider")
    labels = lead.get("labels", {})
    if not isinstance(labels, dict) or labels.get("paseo.parent-agent-id") or labels.get("role", "lead") != "lead":
        raise workflow.WorkflowError("Human binding requires a root Lead; existing parentage is never changed")
    if supervisor_id:
        observer = load_agent_record(supervisor_id)
        if not observer or observer.get("archivedAt") or observer.get("labels", {}).get("role") != "supervisor":
            raise workflow.WorkflowError("Governance binding requires an active Supervisor")
    workspace_id = lead.get("workspaceId")
    if not isinstance(workspace_id, str) or workspace_lifecycle(workspace_id) != "active":
        raise workflow.WorkflowError("Binding requires active workspace authority")
    canonical = dict(labels, role="lead", room_kind="managed_slp", work_epoch="1", task_state="LEASED")
    canonical.setdefault("stack_profile", "budget" if lead["provider"] == "opencode-lead" else "standard")
    prospective = {**lead, "labels": canonical}
    lease = {"state": "active", "room_kind": "managed_slp", "workspace_id": workspace_id,
             "lead_agent_id": lead_id, "supervisor_agent_id": supervisor_id,
             "authority_mode": "observed" if supervisor_id else "direct",
             "task_class": task_class, "work_epoch": 1, "handback_epoch": 0,
             "revision": 1, "decision_state": "WORKING", "bound_by": "human"}
    workflow.verify_context(lease, prospective, pin=True)
    def check(registry: dict[str, Any]) -> None:
        if any(item.get("state") in {"active", "pending"} and item.get("lead_agent_id") == lead_id
               for item in registry["leases"].values()):
            raise workflow.WorkflowError("Lead already holds an active binding or reservation")
        old = registry["leases"].get(workspace_id)
        if old and old.get("state") in {"active", "pending"}:
            raise workflow.WorkflowError("Workspace already has a Lead binding or reservation")
        if old and old.get("lead_agent_id") == lead_id:
            epoch = old.get("work_epoch")
            if type(epoch) is not int or epoch < 1:
                raise workflow.WorkflowError("Previous binding epoch is invalid")
            lease["work_epoch"] = epoch + 1
            canonical["work_epoch"] = str(epoch + 1)
        for record in iter_agent_records():
            if record.get("workspaceId") == workspace_id and record.get("id") != lead_id and not record.get("archivedAt"):
                if record.get("provider") in CUSTOM_LEAD_PROVIDERS or record.get("labels", {}).get("role") == "lead":
                    raise workflow.WorkflowError("Workspace already has another unarchived Lead")
    if not apply:
        try:
            registry = json.loads(LEASES_PATH.read_text())
        except FileNotFoundError:
            registry = {"version": 2, "leases": {}}
        if not isinstance(registry, dict) or not isinstance(registry.get("leases"), dict):
            raise workflow.WorkflowError("Lead registry is malformed")
        for key, value in registry["leases"].items():
            validate_lease_entry(key, value)
        check(registry)
        return {"applied": False, "binding": lease}
    with locked_leases() as registry:
        check(registry)
        response = update_labels(lead_id, canonical, "human-binding", caller_id="human")
        if response_is_error(response) or response is None:
            raise workflow.WorkflowError("Lead label update failed or is uncertain; no binding was granted")
        lease["bound_at"] = utc_timestamp()
        append_history(lease, "BIND_AUTHORITY", "human", "HUMAN", uuid.uuid4().hex, "BOUND")
        registry["leases"][workspace_id] = lease
    return {"applied": True, "binding": lease}


def withdraw_binding(arguments: dict[str, Any], *, apply: bool = False) -> dict[str, Any]:
    required = {"agentId", "expectedWorkEpoch", "expectedRevision", "settlementEvidence"}
    if set(arguments) != required or not isinstance(arguments["settlementEvidence"], str) or not arguments["settlementEvidence"].strip():
        raise workflow.WorkflowError("Withdrawal requires exact epoch/revision and settlementEvidence")
    if not apply:
        return {"applied": False, "operation": "withdraw", "arguments": arguments}
    with locked_leases() as registry:
        lease = lead_lease(registry, arguments["agentId"])
        if not lease or not expected_version_matches(lease, arguments["expectedWorkEpoch"], arguments["expectedRevision"]):
            raise workflow.WorkflowError("Withdrawal has a stale authority binding")
        if lease.get("decision_state") not in {"WORKING", "HANDBACK_READY"}:
            raise workflow.WorkflowError("Resolve uncertain delivery before withdrawing authority")
        if any(not peer.get("archivedAt") and peer.get("labels", {}).get("paseo.parent-agent-id") == arguments["agentId"] for peer in iter_agent_records()):
            raise workflow.WorkflowError("Settle and archive existing descendants before withdrawing authority")
        lease["state"] = "released"
        lease["decision_state"] = "WITHDRAWN"
        lease["released_at"] = utc_timestamp()
        lease["settlement_evidence"] = arguments["settlementEvidence"]
        bump_revision(lease)
        append_history(lease, "WITHDRAW_AUTHORITY", "human", "HUMAN", uuid.uuid4().hex, "WITHDRAWN")
    return {"applied": True, "binding": lease}


def verify_candidate(lease: dict[str, Any], lead: dict[str, Any], supplied: Any = None) -> str | None:
    root, policy, gate = workflow.verify_context(lease, lead, pin=True)
    if not gate["candidate"]:
        return None
    if root is None:
        raise workflow.WorkflowError("Candidate-bound work requires repository placement")
    current = workflow.snapshot(root)["digest"]
    expected = supplied if supplied is not None else lease.get("candidate_digest")
    if current != expected:
        raise workflow.WorkflowError("Candidate changed or digest is missing; inspect and verify the exact candidate again")
    if gate["independent_review"]:
        reviews = lease.get("candidate_reviews", {})
        if not isinstance(reviews, dict) or not any(
            review.get("candidate_digest") == current and review.get("verdict") == "APPROVE"
            and review.get("work_epoch") == lease.get("work_epoch")
            for review in reviews.values() if isinstance(review, dict)
        ):
            raise workflow.WorkflowError("This task class requires an independent review of this exact candidate")
        if any(review.get("candidate_digest") == current and review.get("verdict") == "FINDINGS"
               and review.get("work_epoch") == lease.get("work_epoch")
               for review in reviews.values() if isinstance(review, dict)):
            raise workflow.WorkflowError("Unresolved review findings remain on this candidate")
    return current


def inspect_work_context(agent_id: str, role: str, request_id: Any, arguments: dict[str, Any], *, candidate: bool = False) -> dict[str, Any]:
    if role != "lead" or arguments:
        return denied_tool_result(request_id, "only Lead may inspect its own context without arguments")
    lead = load_agent_record(agent_id)
    with locked_leases() as registry:
        lease = lead_lease(registry, agent_id)
        if not lease or not lead:
            return denied_tool_result(request_id, "caller has no active managed authority")
        root, policy, gate = workflow.verify_context(lease, lead, pin=True)
        result = {"authority_mode": lease.get("authority_mode", "parented"),
                  "work_epoch": lease["work_epoch"], "task_class": lease["task_class"],
                  "gates": gate, "workflow_digest": lease["workflow_digest"],
                  "protocol_path": policy["protocol_path"] if policy else None}
        if candidate:
            if root is None:
                return denied_tool_result(request_id, "candidate needs a repository cwd")
            result["candidate"] = workflow.snapshot(root)
    return text_tool_result(request_id, json.dumps(result, sort_keys=True))


def record_peer_report(agent_id: str, role: str, request_id: Any, arguments: dict[str, Any]) -> dict[str, Any]:
    if role != "lead" or set(arguments) != {"report"}:
        return denied_tool_result(request_id, "only Lead may record a correlated Peer report")
    report = arguments["report"]
    lead = load_agent_record(agent_id)
    peer_id = report.get("peerAgentId") if isinstance(report, dict) else None
    peer = load_agent_record(peer_id) if isinstance(peer_id, str) else None
    with locked_leases() as registry:
        lease = lead_lease(registry, agent_id)
        if not lease or not lead or not peer or lease.get("decision_state") != "WORKING":
            return denied_tool_result(request_id, "report requires active Lead, Peer and working epoch")
        root, _, _ = workflow.verify_context(lease, lead, pin=True)
        workflow.validate_report(report, peer, lead, lease["work_epoch"])
        receipts = lease.setdefault("peer_reports", {})
        report_id = report["reportId"]
        fingerprint = workflow.digest(report)
        if report_id in receipts:
            if receipts[report_id]["digest"] != fingerprint:
                return denied_tool_result(request_id, "report identity already binds different evidence")
            return text_tool_result(request_id, json.dumps(receipts[report_id], sort_keys=True))
        if report["kind"] == "REVIEW":
            if root is None or workflow.snapshot(root)["digest"] != report["payload"]["candidateDigest"]:
                return denied_tool_result(request_id, "review is stale or does not identify this repository candidate")
            lease.setdefault("candidate_reviews", {})[peer_id] = {
                "candidate_digest": report["payload"]["candidateDigest"],
                "verdict": report["payload"]["verdict"], "work_epoch": lease["work_epoch"],
                "report_id": report_id, "evidence": report["payload"]["evidence"],
            }
        ask_id = None
        if report["kind"] == "DEPENDENCY_REQUEST":
            payload = report["payload"]
            question = payload.get("question", payload["evidence"])
            ask_id = f"peer:{report_id}"
            attention.open_ask(
                lease, ask_id=ask_id, question=question, sender=peer_id,
                sender_role="peer", recipient=agent_id, work_epoch=lease["work_epoch"],
                created_at=utc_timestamp(),
            )
        receipt = {"digest": fingerprint, "report": report, "recorded_at": utc_timestamp()}
        if ask_id is not None:
            receipt["ask_id"] = ask_id
        receipts[report_id] = receipt
        bump_revision(lease)
        append_history(lease, "PEER_REPORT", agent_id, "LEAD", report_id, "RECORDED")
    return text_tool_result(request_id, json.dumps(receipt, sort_keys=True))


def _attention_authority(
    registry: dict[str, Any], lead_id: str, actor_id: str, role: str,
    *, require_working: bool = True,
) -> tuple[dict[str, Any], dict[str, Any]] | None:
    lease = lead_lease(registry, lead_id)
    lead = load_agent_record(lead_id)
    if (
        not lease or not lead or (require_working and lease.get("decision_state") != "WORKING")
        or workspace_lifecycle(lease.get("workspace_id", "")) != "active"
        or not workflow.lead_matches(lease, lead)
        or (role == "lead" and actor_id != lead_id)
        or (role == "human" and actor_id != "human")
        or (role in {"supervisor", "human"} and not workflow.governs(lease, actor_id, role))
        or role not in {"lead", "supervisor", "human"}
    ):
        return None
    if role == "supervisor":
        supervisor = load_agent_record(actor_id)
        labels = supervisor.get("labels") if isinstance(supervisor, dict) else None
        if (
            not isinstance(supervisor, dict)
            or supervisor.get("archivedAt") is not None
            or not isinstance(labels, dict)
            or labels.get("role") != "supervisor"
        ):
            return None
    workflow.verify_context(lease, lead, pin=False)
    return lease, lead


def open_room_ask(
    agent_id: str, role: str, request_id: Any, arguments: dict[str, Any]
) -> dict[str, Any]:
    if role != "lead":
        return denied_tool_result(request_id, "only the bound Lead may open a room ask")
    if set(arguments) != {"askId", "question", "expectedWorkEpoch", "expectedRevision"}:
        return error_response(request_id, -32602, "ask requires askId, question, expectedWorkEpoch, and expectedRevision")
    with locked_leases() as registry:
        authority = _attention_authority(registry, agent_id, agent_id, role)
        if authority is None:
            return denied_tool_result(request_id, "caller has no active working room authority")
        lease, _ = authority
        epoch = lease.get("work_epoch")
        if type(arguments["expectedWorkEpoch"]) is not int or arguments["expectedWorkEpoch"] != epoch:
            return denied_tool_result(request_id, "stale room ask work epoch")
        if type(arguments["expectedRevision"]) is not int or arguments["expectedRevision"] < 1:
            return error_response(request_id, -32602, "expectedRevision must be a positive integer")
        recipient = workflow.governance_id(lease) or "human"
        ask_id = arguments["askId"]
        question = arguments["question"]
        existing = attention.asks_for(lease).get(ask_id) if isinstance(ask_id, str) else None
        if not expected_version_matches(lease, epoch, arguments["expectedRevision"]):
            if existing is None:
                return denied_tool_result(request_id, "stale room ask revision")
            item, created = attention.open_ask(
                lease, ask_id=ask_id, question=question, sender=agent_id,
                sender_role="lead", recipient=recipient, work_epoch=epoch,
                created_at=utc_timestamp(),
            )
            return text_tool_result(request_id, json.dumps({"ask": item, "created": created}, sort_keys=True))
        item, created = attention.open_ask(
            lease, ask_id=ask_id, question=question, sender=agent_id,
            sender_role="lead", recipient=recipient, work_epoch=epoch,
            created_at=utc_timestamp(),
        )
        if created:
            bump_revision(lease)
            append_history(lease, "ROOM_ASK", agent_id, "LEAD", ask_id, "OPEN")
        return text_tool_result(request_id, json.dumps({"ask": item, "created": created}, sort_keys=True))


def answer_room_ask(
    agent_id: str, role: str, request_id: Any, arguments: dict[str, Any]
) -> dict[str, Any]:
    if role not in {"lead", "supervisor", "human"}:
        return denied_tool_result(request_id, "only the responsible room recipient may answer")
    if set(arguments) != {"leadAgentId", "askId", "answer", "expectedWorkEpoch", "expectedRevision"}:
        return error_response(request_id, -32602, "answer requires leadAgentId, askId, answer, expectedWorkEpoch, and expectedRevision")
    lead_id = arguments.get("leadAgentId")
    if not isinstance(lead_id, str):
        return error_response(request_id, -32602, "leadAgentId must be a string")
    with locked_leases() as registry:
        authority = _attention_authority(registry, lead_id, agent_id, role)
        if authority is None:
            return denied_tool_result(request_id, "caller has no active working room authority")
        lease, _ = authority
        epoch = lease.get("work_epoch")
        if type(arguments["expectedWorkEpoch"]) is not int or arguments["expectedWorkEpoch"] != epoch:
            return denied_tool_result(request_id, "stale room answer work epoch")
        if type(arguments["expectedRevision"]) is not int or arguments["expectedRevision"] < 1:
            return error_response(request_id, -32602, "expectedRevision must be a positive integer")
        recipient = "human" if role == "human" else agent_id
        ask_id = arguments["askId"]
        existing = attention.asks_for(lease).get(ask_id) if isinstance(ask_id, str) else None
        if existing is None or existing.get("recipient_agent_id") != recipient:
            return denied_tool_result(request_id, "ask does not belong to this recipient")
        if not expected_version_matches(lease, epoch, arguments["expectedRevision"]):
            if existing.get("status") != "ANSWERED":
                return denied_tool_result(request_id, "stale room answer revision")
        item, changed = attention.answer_ask(
            lease, ask_id=ask_id, answer=arguments["answer"], actor=recipient,
            work_epoch=epoch, answered_at=utc_timestamp(),
        )
        if changed:
            bump_revision(lease)
            append_history(lease, "ROOM_ASK", agent_id, role.upper(), ask_id, "ANSWERED")
        return text_tool_result(request_id, json.dumps({"ask": item, "answered": changed}, sort_keys=True))


def list_room_attention(
    agent_id: str, role: str, request_id: Any, arguments: dict[str, Any]
) -> dict[str, Any]:
    if role not in {"lead", "supervisor", "human"}:
        return denied_tool_result(request_id, "only room Lead or governance may inspect attention")
    if set(arguments) != {"leadAgentId"} or not isinstance(arguments.get("leadAgentId"), str):
        return error_response(request_id, -32602, "attention list requires leadAgentId")
    with read_locked_leases() as registry:
        authority = _attention_authority(registry, arguments["leadAgentId"], agent_id, role, require_working=False)
        if authority is None:
            return denied_tool_result(request_id, "caller has no active working room authority")
        lease, _ = authority
        epoch = lease["work_epoch"]
        has_supervisor = workflow.governance_id(lease) is not None
        now = dt.datetime.now(dt.UTC)
        asks = []
        for item in attention.asks_for(lease).values():
            current = item["work_epoch"] == epoch
            view = attention.attention_for(item, now, has_supervisor=has_supervisor) if current and lease.get("decision_state") == "WORKING" else dict(item, attention=None, escalate_to=None)
            asks.append(dict(view, current_epoch=current))
        asks.sort(key=lambda item: (item["created_at"], item["ask_id"]))
        result = {"work_epoch": epoch, "revision": lease["revision"], "asks": asks}
    return text_tool_result(request_id, json.dumps(result, sort_keys=True))


def reconcile_workspace_authority(lease: dict[str, Any], operation: str) -> str:
    workspace_id = lease.get("workspace_id")
    state = workspace_lifecycle(workspace_id) if isinstance(workspace_id, str) else "unreadable"
    if state in {"missing", "archived"}:
        lease["state"] = "released"
        lease["release_reason"] = f"{state}_workspace_{operation}_reconciled"
        lease["released_at"] = utc_timestamp()
    return state


def normalize_lease_epoch(lease: dict[str, Any], labels: dict[str, Any] | None = None) -> int:
    """Upgrade a v1 managed lease without reopening an already-ready epoch."""
    if lease.get("room_kind") != "managed_slp":
        return 0
    epoch = lease.get("work_epoch", 1)
    if not isinstance(epoch, int) or epoch < 1:
        return 0
    lease.setdefault("work_epoch", epoch)
    if lease.pop("legacy_epoch_unknown", False):
        if isinstance(labels, dict) and labels.get("task_state") == "HANDBACK_READY":
            lease["handback_epoch"] = epoch
            lease["decision_state"] = "HANDBACK_READY"
        else:
            lease["handback_epoch"] = 0
            lease["decision_state"] = "WORKING"
    elif "handback_epoch" not in lease:
        if isinstance(labels, dict) and labels.get("task_state") == "HANDBACK_READY":
            lease["handback_epoch"] = epoch
            lease["decision_state"] = "HANDBACK_READY"
        else:
            lease["handback_epoch"] = 0
            lease.setdefault("decision_state", "WORKING")
    if lease.get("decision_state") == "HANDBACK_READY" and not isinstance(
        lease.get("evidence_digest"), str
    ):
        message = lease.get("handback_message")
        if not isinstance(message, str):
            message = ""
            lease["legacy_evidence_missing"] = True
        lease["evidence_digest"] = evidence_digest(epoch, message)
    return epoch


def response_is_error(response: Any) -> bool:
    if not isinstance(response, dict) or "error" in response:
        return True
    result = response.get("result")
    return isinstance(result, dict) and result.get("isError") is True


def delivery_response_status(response: Any) -> str:
    """Classify delivery without treating missing/ambiguous transport as rejection."""
    if not isinstance(response, dict):
        return "uncertain"
    if "error" in response:
        return "rejected"
    result = response.get("result")
    if not isinstance(result, dict):
        return "uncertain"
    return "rejected" if result.get("isError") is True else "delivered"


def update_labels(agent_id: str, labels: dict[str, str], request_id: Any, *, caller_id: str | None = None) -> dict[str, Any] | None:
    return upstream_call(
        caller_id or agent_id,
        {
            "jsonrpc": "2.0",
            "id": request_id,
            "method": "tools/call",
            "params": {
                "name": "update_agent",
                "arguments": {"agentId": agent_id, "labels": labels},
            },
        },
    )


def upstream_call(
    agent_id: str,
    payload: dict[str, Any],
    *,
    agent_scoped: bool = True,
) -> dict[str, Any] | None:
    if agent_id == "human":
        agent_scoped = False
    url = f"{UPSTREAM}?callerAgentId={agent_id}" if agent_scoped else UPSTREAM
    request = urllib.request.Request(
        url,
        data=json.dumps(payload, separators=(",", ":")).encode(),
        headers={
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read().decode()
    except (urllib.error.URLError, TimeoutError) as error:
        raise RuntimeError(f"Paseo MCP upstream unavailable: {error}") from error
    if not body.strip():
        return None
    content_type = response.headers.get("content-type", "")
    if "text/event-stream" in content_type:
        messages = []
        for line in body.splitlines():
            if not line.startswith("data:"):
                continue
            with_data = line.split(":", 1)[1].strip()
            if with_data:
                messages.append(json.loads(with_data))
        if not messages:
            return None
        request_id = payload.get("id")
        for message in messages:
            if message.get("id") == request_id:
                if agent_scoped and method_not_found(message):
                    fallback_payload = dict(payload)
                    params = fallback_payload.get("params")
                    if fallback_payload.get("method") == "tools/call" and isinstance(params, dict):
                        fallback_params = dict(params)
                        name = fallback_params.get("name")
                        arguments = fallback_params.get("arguments", {})
                        if isinstance(name, str) and isinstance(arguments, dict):
                            fallback_params["arguments"] = unscoped_arguments(
                                agent_id, name, arguments
                            )
                        fallback_payload["params"] = fallback_params
                    return upstream_call(
                        agent_id, fallback_payload, agent_scoped=False
                    )
                return message
        return None
    value = json.loads(body)
    if not isinstance(value, dict):
        return None
    request_id = payload.get("id")
    if value.get("id") != request_id:
        return None
    if agent_scoped and method_not_found(value):
        fallback_payload = dict(payload)
        params = fallback_payload.get("params")
        if fallback_payload.get("method") == "tools/call" and isinstance(params, dict):
            fallback_params = dict(params)
            name = fallback_params.get("name")
            arguments = fallback_params.get("arguments", {})
            if isinstance(name, str) and isinstance(arguments, dict):
                fallback_params["arguments"] = unscoped_arguments(agent_id, name, arguments)
            fallback_payload["params"] = fallback_params
        return upstream_call(agent_id, fallback_payload, agent_scoped=False)
    return value


def method_not_found(response: Any) -> bool:
    if not isinstance(response, dict):
        return False
    error = response.get("error")
    return isinstance(error, dict) and error.get("code") == -32601


def tool_not_available(response: Any) -> bool:
    if method_not_found(response) or not isinstance(response, dict):
        return method_not_found(response)
    error = response.get("error")
    if not isinstance(error, dict) or error.get("code") not in {-32601, -32602}:
        return False
    message = error.get("message")
    return isinstance(message, str) and bool(
        re.search(r"(?i)\b(?:tool|method)\b.*\b(?:not found|unknown|unavailable)\b", message)
    )


def unscoped_arguments(
    agent_id: str,
    name: str,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    """Preserve agent-scoped defaults when Paseo 0.8 exposes an empty caller policy.

    Room providers intentionally disable native Paseo tool injection. Paseo 0.8
    reuses that per-agent policy for /mcp/agents, leaving caller-scoped catalogs
    empty. The room proxy remains the authority boundary, so its guarded fallback
    uses the top-level catalog and restores only the caller context that the daemon
    would otherwise derive.
    """
    scoped = dict(arguments)
    caller = load_agent_record(agent_id)
    workspace_id = caller.get("workspaceId") if isinstance(caller, dict) else None
    cwd = caller.get("cwd") if isinstance(caller, dict) else None

    if name == "create_agent":
        if "workspaceId" not in scoped and isinstance(workspace_id, str):
            scoped["workspaceId"] = workspace_id
        labels = scoped.get("labels")
        next_labels = dict(labels) if isinstance(labels, dict) else {}
        next_labels["paseo.parent-agent-id"] = agent_id
        scoped["labels"] = next_labels
        scoped.setdefault("background", True)
        scoped.setdefault("notifyOnFinish", True)
    elif name == "send_agent_prompt":
        scoped.setdefault("background", True)
        scoped.setdefault("notifyOnFinish", True)
    elif name == "create_workspace":
        if "path" not in scoped and isinstance(cwd, str):
            scoped["path"] = cwd
    elif name == "rename_workspace":
        if "workspaceId" not in scoped and isinstance(workspace_id, str):
            scoped["workspaceId"] = workspace_id
    elif name in {"list_terminals", "create_terminal"}:
        if "cwd" not in scoped and isinstance(cwd, str):
            scoped["cwd"] = cwd
    return scoped


def allowed_tool(role: str, name: str) -> bool:
    if role == "peer":
        return False
    if name in SCHEDULE_MUTATION_TOOLS:
        return False
    if role == "supervisor":
        if name.startswith(SUPERVISOR_BLOCKED_PREFIXES):
            return False
        if name in SUPERVISOR_BLOCKED_TOOLS:
            return False
    if role == "lead" and name in LEAD_BLOCKED_TOOLS:
        return False
    return True


def run_guard(
    role: str,
    event: str,
    agent_id: str,
    tool_name: str,
    arguments: dict[str, Any],
    tool_use_id: str,
    response: Any = None,
) -> tuple[bool, str | None, dict[str, Any]]:
    payload: dict[str, Any] = {
        "hook_event_name": event,
        "tool_name": f"mcp__paseo__{tool_name}",
        "tool_input": arguments,
        "tool_use_id": tool_use_id,
    }
    if event == "PostToolUse":
        payload["tool_response"] = response
    environment = {
        **os.environ,
        "PASEO_AGENT_ID": agent_id,
        "PASEO_ROOM_ROLE": role,
    }
    completed = subprocess.run(
        ["python3", str(GUARD), "--role", role],
        input=json.dumps(payload),
        text=True,
        capture_output=True,
        env=environment,
        timeout=15,
    )
    if completed.returncode != 0:
        return False, f"room guard failed: {completed.stderr.strip()}", arguments
    if not completed.stdout.strip():
        return True, None, arguments
    try:
        output = json.loads(completed.stdout)
    except json.JSONDecodeError:
        return False, "room guard returned invalid JSON", arguments
    specific = output.get("hookSpecificOutput", {})
    if specific.get("permissionDecision") == "deny":
        return False, specific.get("permissionDecisionReason", "denied"), arguments
    updated = specific.get("updatedInput")
    return True, None, updated if isinstance(updated, dict) else arguments


def list_tools(agent_id: str, role: str, request_id: Any) -> dict[str, Any]:
    response = upstream_call(
        agent_id,
        {"jsonrpc": "2.0", "id": request_id, "method": "tools/list", "params": {}},
    )
    result = response.get("result") if isinstance(response, dict) else None
    scoped_tools = result.get("tools") if isinstance(result, dict) else None
    missing_control_catalog = (
        isinstance(scoped_tools, list)
        and not any(
            isinstance(item, dict) and item.get("name") == "list_agents"
            for item in scoped_tools
        )
    )
    if method_not_found(response) or missing_control_catalog:
        response = upstream_call(
            agent_id,
            {"jsonrpc": "2.0", "id": request_id, "method": "tools/list", "params": {}},
            agent_scoped=False,
        )
    if not response or "result" not in response:
        return error_response(request_id, -32603, "Paseo MCP returned no tool catalog")
    result = response.get("result")
    tools = result.get("tools") if isinstance(result, dict) else None
    if not isinstance(tools, list):
        return error_response(request_id, -32603, "Paseo MCP returned an invalid tool catalog")
    filtered = [
        item
        for item in tools
        if isinstance(item, dict)
        and isinstance(item.get("name"), str)
        and allowed_tool(role, item["name"])
    ]
    if role == "lead":
        filtered.extend((HAND_BACK_TOOL, SUBMIT_RESULT_TOOL, WORK_CONTEXT_TOOL,
                         WORK_CANDIDATE_TOOL, PEER_REPORT_TOOL, RECOVER_PEER_CALLBACKS_TOOL,
                         OPEN_ROOM_ASK_TOOL, ANSWER_ROOM_ASK_TOOL,
                         LIST_ROOM_ATTENTION_TOOL, INSPECT_PEER_ATTENTION_TOOL))
    if role == "supervisor":
        filtered.extend(
            (
                LIST_SLP_DECISIONS_TOOL,
                REOPEN_WORK_EPOCH_TOOL,
                RESOLVE_SLP_DELIVERY_TOOL,
                RECORD_SLP_DECISION_TOOL,
                ARCHIVE_SLP_WORKSPACE_TOOL,
                RECOVER_WORKING_LEAD_TOOL,
                INSPECT_SLP_OWNERSHIP_TOOL,
                RETIRE_LEGACY_LEAD_TOOL,
                ANSWER_ROOM_ASK_TOOL,
                LIST_ROOM_ATTENTION_TOOL,
            )
        )
    return {
        "jsonrpc": "2.0",
        "id": request_id,
        "result": {"tools": filtered},
    }


def handback_to_parent(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role != "lead":
        return denied_tool_result(request_id, "only Lead can hand back to a parent seat")
    if "message" not in arguments or set(arguments) - {"message", "candidateDigest"}:
        return error_response(request_id, -32602, "handback requires message and optional candidateDigest")
    message = arguments.get("message")
    if not isinstance(message, str) or not message.strip():
        return error_response(request_id, -32602, "handback message must be non-empty")

    lead = load_agent_record(agent_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None
    if (
        not isinstance(labels, dict)
        or labels.get("role") != "lead"
        or lead.get("archivedAt") is not None
    ):
        return denied_tool_result(request_id, "caller is not an active Lead seat")
    with locked_leases() as registry:
        bound = lead_lease(registry, agent_id)
        if not bound or not workflow.lead_matches(bound, lead):
            return denied_tool_result(request_id, "caller has no matching managed authority binding")
        parent_id = workflow.governance_id(bound)
    parent = load_agent_record(parent_id) if isinstance(parent_id, str) else None
    parent_labels = parent.get("labels") if isinstance(parent, dict) else None
    parent_is_supervisor = (
        isinstance(parent_labels, dict)
        and parent_labels.get("role") == "supervisor"
    ) or (
        isinstance(parent, dict)
        and parent.get("provider")
        in {"codex-supervisor", "claude-supervisor", "opencode-supervisor"}
    )
    if (
        parent_id is not None and (not parent_is_supervisor
        or parent.get("archivedAt") is not None)
    ):
        return denied_tool_result(request_id, "active parent governance seat not found")

    with locked_leases() as registry:
        lease = lead_lease(registry, agent_id)
        if not lease or lease.get("supervisor_agent_id") != parent_id:
            return denied_tool_result(request_id, "caller has no active managed SLP lease")
        workspace_state = reconcile_workspace_authority(lease, "handback")
        if workspace_state != "active":
            return denied_tool_result(
                request_id,
                f"managed workspace authority is {workspace_state}; handback failed closed",
            )
        epoch = normalize_lease_epoch(lease, labels)
        handback_epoch = lease.get("handback_epoch", 0)
        decision_state = lease.get("decision_state")
        if epoch < 1:
            return denied_tool_result(request_id, "managed SLP work epoch is invalid")
        if handback_epoch == epoch or decision_state == "HANDBACK_READY":
            return denied_tool_result(
                request_id,
                f"final handback for work epoch {epoch} was already delivered",
            )
        if decision_state != "WORKING":
            return denied_tool_result(
                request_id,
                f"work epoch {epoch} has unresolved delivery state {decision_state}",
            )
        if handback_epoch not in range(0, epoch):
            return denied_tool_result(request_id, "managed SLP handback epoch is invalid")
        revision = normalize_lease_revision(lease)
        candidate_digest = verify_candidate(lease, lead, arguments.get("candidateDigest"))
        if candidate_digest:
            lease["candidate_digest"] = candidate_digest
        correlation_id = str(uuid.uuid4())
        lease["decision_state"] = "HANDBACK_SENDING"
        lease["handback_message"] = message.strip()
        lease["evidence_digest"] = evidence_digest(epoch, message.strip())
        if candidate_digest:
            lease["evidence_digest"] = digest_payload({"work_epoch": epoch, "handback_message": message.strip(), "candidate_digest": candidate_digest})
        lease["delivery_started_at"] = utc_timestamp()
        lease["delivery_correlation_id"] = correlation_id
        reservation_revision = bump_revision(lease)
        append_history(
            lease, "HANDBACK", agent_id, "LEAD", correlation_id, "RESERVED"
        )

    try:
        response = {"result": {"structuredContent": {"localReceipt": correlation_id}}} if parent_id is None else upstream_call(
            agent_id,
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": "tools/call",
                "params": {
                    "name": "send_agent_prompt",
                    "arguments": {
                        "agentId": parent_id,
                        "prompt": f"Final Lead handback (work epoch {epoch}, candidate {candidate_digest or 'legacy-unbound'}):\n\n{message.strip()}",
                        "background": True,
                        "notifyOnFinish": False,
                    },
                },
            },
        )
    except Exception:
        with locked_leases() as registry:
            lease = lead_lease(registry, agent_id)
            if (
                lease
                and lease.get("work_epoch") == epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "HANDBACK", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        raise
    delivery_status = "delivered" if parent_id is None else delivery_response_status(response)
    if delivery_status == "uncertain":
        with locked_leases() as registry:
            lease = lead_lease(registry, agent_id)
            if (
                lease
                and lease.get("work_epoch") == epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "HANDBACK", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        return text_tool_result(
            request_id,
            "Final handback completion is uncertain; it was not retried and requires Human resolution.",
            is_error=True,
        )
    if delivery_status == "rejected":
        with locked_leases() as registry:
            lease = lead_lease(registry, agent_id)
            if (
                lease
                and lease.get("decision_state") == "HANDBACK_SENDING"
                and lease.get("work_epoch") == epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "HANDBACK", agent_id, "TRANSPORT", correlation_id, "REJECTED"
                )
                lease["decision_state"] = "WORKING"
                lease.pop("delivery_started_at", None)
                lease.pop("delivery_correlation_id", None)
                bump_revision(lease)
        return text_tool_result(
            request_id,
            "Final handback was definitively rejected; this epoch may retry.",
            is_error=True,
        )

    with locked_leases() as registry:
        lease = lead_lease(registry, agent_id)
        if (
            not lease
            or lease.get("decision_state") != "HANDBACK_SENDING"
            or lease.get("work_epoch") != epoch
            or lease.get("revision") != reservation_revision
            or lease.get("delivery_correlation_id") != correlation_id
        ):
            return text_tool_result(
                request_id,
                "Final handback was delivered but lifecycle reservation changed unexpectedly.",
                is_error=True,
            )
        lease["handback_epoch"] = epoch
        lease["decision_state"] = "HANDBACK_READY"
        lease["handback_at"] = utc_timestamp()
        lease.pop("delivery_started_at", None)
        lease.pop("delivery_correlation_id", None)
        bump_revision(lease)
        append_history(
            lease, "HANDBACK", agent_id, "TRANSPORT", correlation_id, "DELIVERED"
        )
        updated_labels = dict(labels)
        updated_labels.update(
            {
                "room_kind": "managed_slp",
                "work_epoch": str(epoch),
                "task_state": "HANDBACK_READY",
            }
        )
    label_response = update_labels(agent_id, updated_labels, request_id)
    if response_is_error(label_response):
        return text_tool_result(
            request_id,
            f"Final handback for work epoch {epoch} was delivered and deduplicated, "
            "but the Lead display labels could not be updated.",
        )
    return text_tool_result(
        request_id,
        f"Final handback delivered for work epoch {epoch}; Lead is now HANDBACK_READY.",
    )


def list_slp_decisions(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can list SLP decisions")
    if arguments:
        return error_response(request_id, -32602, "list_slp_decisions takes no arguments")
    pending = []
    with locked_leases() as registry:
        for workspace_id, lease in registry["leases"].items():
            if not isinstance(lease, dict) or lease.get("state") != "active":
                continue
            if lease.get("room_kind") != "managed_slp":
                continue
            if not workflow.governs(lease, agent_id, role):
                continue
            decision_state = lease.get("decision_state")
            revision = normalize_lease_revision(lease)
            if decision_state == "ARCHIVE_SENDING":
                epoch = lease.get("work_epoch")
                if not isinstance(epoch, int) or epoch < 1:
                    return text_tool_result(
                        request_id, "Managed archive work epoch is invalid.", is_error=True
                    )
                pending.append(
                    {
                        "workspace_id": workspace_id,
                        "lead_agent_id": lease.get("lead_agent_id"),
                        "room_kind": "managed_slp",
                        "work_epoch": epoch,
                        "revision": revision,
                        "decision_state": decision_state,
                        "correlation_id": lease.get("delivery_correlation_id"),
                        "evidence_digest": lease.get("evidence_digest"),
                        "handback_at": lease.get("handback_at"),
                        "handback_message": lease.get("handback_message"),
                        "human_actions": ["resolve_delivery_uncertainty"],
                    }
                )
                continue
            workspace_state = workspace_lifecycle(workspace_id)
            if workspace_state == "unreadable":
                return text_tool_result(
                    request_id,
                    f"Workspace authority is unreadable for {workspace_id}; decision queue failed closed.",
                    is_error=True,
                )
            if workspace_state in {"missing", "archived"}:
                lease["state"] = "released"
                lease["release_reason"] = f"{workspace_state}_workspace_queue_reconciled"
                lease["released_at"] = (
                    dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")
                )
                continue
            lead_id = lease.get("lead_agent_id")
            record_state, lead = (
                agent_record_status(lead_id)
                if isinstance(lead_id, str)
                else ("missing", None)
            )
            if record_state in {"missing", "archived"}:
                lease["state"] = "released"
                lease["release_reason"] = f"{record_state}_agent_queue_reconciled"
                lease["released_at"] = (
                    dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")
                )
                continue
            if record_state != "active" or not isinstance(lead, dict):
                return text_tool_result(
                    request_id,
                    f"Lead authority is unreadable for {lead_id}; decision queue failed closed.",
                    is_error=True,
                )
            labels = lead.get("labels")
            epoch = normalize_lease_epoch(lease, labels if isinstance(labels, dict) else None)
            decision_state = lease.get("decision_state")
            if epoch < 1 or decision_state not in {
                "HANDBACK_READY",
                "HANDBACK_SENDING",
                "REOPEN_SENDING",
            }:
                continue
            decided = (
                decision_state == "HANDBACK_READY"
                and lease.get("human_decision_epoch") == epoch
                and lease.get("human_decision_evidence_digest") == lease.get("evidence_digest")
                and lease.get("human_decision") in {"ACCEPTED", "ABANDONED"}
            )
            actions = (
                ["archive"]
                if decided
                else ["accept", "abandon", "bounded_follow_up"]
                if decision_state == "HANDBACK_READY"
                else ["resolve_delivery_uncertainty"]
            )
            pending.append(
                {
                    "workspace_id": workspace_id,
                    "lead_agent_id": lease.get("lead_agent_id"),
                    "room_kind": lease.get("room_kind", "managed_slp"),
                    "work_epoch": epoch,
                    "revision": revision,
                    "decision_state": decision_state,
                    "correlation_id": lease.get("delivery_correlation_id"),
                    "evidence_digest": lease.get("evidence_digest"),
                    "handback_at": lease.get("handback_at"),
                    "handback_message": lease.get("handback_message"),
                    "human_actions": actions,
                    "authority_mode": lease.get("authority_mode", "parented"),
                    "candidate_digest": lease.get("candidate_digest"),
                }
            )
    return text_tool_result(request_id, json.dumps({"pending": pending}, sort_keys=True))


def reopen_work_epoch(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can reopen SLP work")
    required = {"agentId", "prompt", "expectedWorkEpoch", "expectedRevision"}
    if set(arguments) != required:
        return error_response(
            request_id, -32602, "reopen requires agentId, prompt, expectedWorkEpoch, and expectedRevision"
        )
    lead_id = arguments.get("agentId")
    prompt = arguments.get("prompt")
    if not isinstance(lead_id, str) or not isinstance(prompt, str) or not prompt.strip():
        return error_response(request_id, -32602, "reopen agentId and prompt must be non-empty")
    lead = load_agent_record(lead_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None
    if (
        not isinstance(labels, dict)
        or labels.get("role") != "lead"
        or lead.get("archivedAt") is not None
    ):
        return denied_tool_result(request_id, "target is not an active owned Lead")

    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if not lease or not workflow.governs(lease, agent_id, role):
            return denied_tool_result(request_id, "target has no active managed SLP lease")
        if not workflow.lead_matches(lease, lead):
            return denied_tool_result(request_id, "Lead authority binding drifted")
        workspace_state = reconcile_workspace_authority(lease, "reopen")
        if workspace_state != "active":
            return denied_tool_result(
                request_id,
                f"managed workspace authority is {workspace_state}; reopen failed closed",
            )
        epoch = normalize_lease_epoch(lease, labels)
        if not expected_version_matches(
            lease, arguments.get("expectedWorkEpoch"), arguments.get("expectedRevision")
        ):
            return denied_tool_result(request_id, "stale managed SLP epoch or revision")
        if lease.get("human_decision") in {"ACCEPTED", "ABANDONED"}:
            return denied_tool_result(request_id, "Human decision for this work epoch is already recorded")
        if (
            not isinstance(epoch, int)
            or lease.get("handback_epoch", 0) != epoch
            or lease.get("decision_state") != "HANDBACK_READY"
            or lease.get("human_decision") in {"ACCEPTED", "ABANDONED"}
        ):
            return denied_tool_result(request_id, "target is not awaiting a Human decision")
        next_epoch = epoch + 1
        correlation_id = str(uuid.uuid4())
        lease["work_epoch"] = next_epoch
        lease["decision_state"] = "REOPEN_SENDING"
        lease["delivery_started_at"] = utc_timestamp()
        lease["delivery_correlation_id"] = correlation_id
        reserve_prior_evidence(lease)
        for key in (
            "human_decision", "human_decision_epoch", "human_decision_evidence_digest",
            "human_decision_at",
        ):
            lease.pop(key, None)
        reservation_revision = bump_revision(lease)
        append_history(
            lease, "REOPEN", agent_id, "HUMAN" if role == "human" else "SUPERVISOR", correlation_id, "RESERVED"
        )
    try:
        prompt_response = upstream_call(
            agent_id,
            {
            "jsonrpc": "2.0",
            "id": request_id,
            "method": "tools/call",
            "params": {
                "name": "send_agent_prompt",
                "arguments": {
                    "agentId": lead_id,
                    "prompt": prompt.strip(),
                    "background": True,
                    "notifyOnFinish": False,
                },
            },
            },
        )
    except Exception:
        with locked_leases() as registry:
            lease = lead_lease(registry, lead_id)
            if (
                lease
                and lease.get("work_epoch") == next_epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "REOPEN", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        raise
    delivery_status = delivery_response_status(prompt_response)
    if delivery_status == "uncertain":
        with locked_leases() as registry:
            lease = lead_lease(registry, lead_id)
            if (
                lease
                and lease.get("work_epoch") == next_epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "REOPEN", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        return text_tool_result(
            request_id,
            "Follow-up prompt completion is uncertain; it was not retried and requires Human resolution.",
            is_error=True,
        )
    if delivery_status == "rejected":
        with locked_leases() as registry:
            lease = lead_lease(registry, lead_id)
            if (
                lease
                and lease.get("decision_state") == "REOPEN_SENDING"
                and lease.get("work_epoch") == next_epoch
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "REOPEN", agent_id, "TRANSPORT", correlation_id, "REJECTED"
                )
                lease["work_epoch"] = epoch
                lease["decision_state"] = "HANDBACK_READY"
                lease.pop("delivery_started_at", None)
                lease.pop("delivery_correlation_id", None)
                restore_prior_evidence(lease)
                bump_revision(lease)
        return text_tool_result(
            request_id,
            "Follow-up prompt was definitively rejected; work epoch was not advanced.",
            is_error=True,
        )
    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if (
            not lease
            or lease.get("decision_state") != "REOPEN_SENDING"
            or lease.get("work_epoch") != next_epoch
            or lease.get("revision") != reservation_revision
            or lease.get("delivery_correlation_id") != correlation_id
        ):
            return text_tool_result(
                request_id,
                "Follow-up was delivered but lifecycle reservation changed unexpectedly.",
                is_error=True,
            )
        lease["decision_state"] = "WORKING"
        lease["reopened_at"] = utc_timestamp()
        lease.pop("delivery_started_at", None)
        lease.pop("delivery_correlation_id", None)
        discard_prior_evidence(lease)
        bump_revision(lease)
        append_history(
            lease, "REOPEN", agent_id, "TRANSPORT", correlation_id, "DELIVERED"
        )
        updated_labels = dict(labels)
        updated_labels.update(
            {
                "room_kind": "managed_slp",
                "work_epoch": str(next_epoch),
                "task_state": "LEASED",
            }
        )
    label_response = update_labels(lead_id, updated_labels, request_id)
    if response_is_error(label_response):
        return text_tool_result(
            request_id,
            f"Managed SLP Lead reopened at work epoch {next_epoch}, but display labels could not be updated.",
        )
    return text_tool_result(request_id, f"Managed SLP Lead reopened at work epoch {next_epoch}.")


def resolve_slp_delivery(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can resolve SLP delivery")
    required = {
        "agentId", "resolution", "expectedWorkEpoch", "expectedRevision", "correlationId"
    }
    if set(arguments) != required:
        return error_response(request_id, -32602, "resolution requires agentId, resolution, expectedWorkEpoch, expectedRevision, and correlationId")
    lead_id = arguments.get("agentId")
    resolution = arguments.get("resolution")
    if not isinstance(lead_id, str) or resolution not in {"DELIVERED", "NOT_DELIVERED"}:
        return error_response(request_id, -32602, "invalid delivery resolution")
    lead = load_agent_record(lead_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None

    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if not lease or not workflow.governs(lease, agent_id, role):
            return denied_tool_result(request_id, "target has no active managed SLP lease")
        state = lease.get("decision_state")
        epoch = normalize_lease_epoch(lease, labels)
        if state != "ARCHIVE_SENDING" and (
            not isinstance(labels, dict)
            or labels.get("role") != "lead"
            or not workflow.lead_matches(lease, lead)
            or lead.get("archivedAt") is not None
        ):
            return denied_tool_result(request_id, "target is not an active owned Lead")
        correlation_id = arguments.get("correlationId")
        if (
            not expected_version_matches(
                lease, arguments.get("expectedWorkEpoch"), arguments.get("expectedRevision")
            )
            or not isinstance(correlation_id, str)
            or lease.get("delivery_correlation_id") != correlation_id
        ):
            return denied_tool_result(request_id, "stale managed SLP delivery resolution")
        if state not in {"HANDBACK_SENDING", "REOPEN_SENDING", "ARCHIVE_SENDING"} or epoch < 1:
            return denied_tool_result(request_id, "target has no uncertain delivery to resolve")

        updated_labels = dict(labels) if isinstance(labels, dict) else None
        if state == "ARCHIVE_SENDING":
            if resolution == "DELIVERED":
                lease["state"] = "released"
                lease["decision_state"] = "ARCHIVED"
                lease["release_reason"] = "human_resolved_workspace_archived"
                lease["released_at"] = utc_timestamp()
            else:
                lease["decision_state"] = "HANDBACK_READY"
        elif state == "HANDBACK_SENDING":
            if resolution == "DELIVERED":
                lease["handback_epoch"] = epoch
                lease["decision_state"] = "HANDBACK_READY"
                lease["handback_at"] = (
                    dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")
                )
                updated_labels.update(
                    {"room_kind": "managed_slp", "work_epoch": str(epoch), "task_state": "HANDBACK_READY"}
                )
            else:
                lease["decision_state"] = "WORKING"
                lease.pop("handback_message", None)
                updated_labels["task_state"] = "LEASED"
        else:
            previous_epoch = epoch - 1
            if resolution == "DELIVERED":
                lease["decision_state"] = "WORKING"
                discard_prior_evidence(lease)
                updated_labels.update(
                    {"room_kind": "managed_slp", "work_epoch": str(epoch), "task_state": "LEASED"}
                )
            else:
                lease["work_epoch"] = previous_epoch
                lease["decision_state"] = "HANDBACK_READY"
                restore_prior_evidence(lease)
                updated_labels.update(
                    {
                        "room_kind": "managed_slp",
                        "work_epoch": str(previous_epoch),
                        "task_state": "HANDBACK_READY",
                    }
                )
        lease.pop("delivery_started_at", None)
        lease.pop("delivery_correlation_id", None)
        lease["delivery_resolved_as"] = resolution
        lease["delivery_resolved_at"] = utc_timestamp()
        bump_revision(lease)
        append_history(
            lease, "RESOLVE_DELIVERY", agent_id, "HUMAN" if role == "human" else "HUMAN_VIA_SUPERVISOR",
            correlation_id, resolution,
        )

    if updated_labels is None:
        return text_tool_result(request_id, f"Managed SLP delivery resolved as {resolution}.")
    label_response = update_labels(lead_id, updated_labels, request_id)
    if response_is_error(label_response):
        return text_tool_result(
            request_id,
            "Delivery uncertainty was resolved in the ledger, but display labels could not be updated.",
        )
    return text_tool_result(request_id, f"Managed SLP delivery resolved as {resolution}.")


def record_slp_decision(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can record an SLP decision")
    required = {
        "agentId", "decision", "evidenceDigest", "expectedWorkEpoch", "expectedRevision"
    }
    if set(arguments) != required:
        return error_response(request_id, -32602, "decision requires agentId, decision, evidenceDigest, expectedWorkEpoch, and expectedRevision")
    lead_id = arguments.get("agentId")
    decision = arguments.get("decision")
    digest = arguments.get("evidenceDigest")
    if (
        not isinstance(lead_id, str)
        or decision not in {"ACCEPTED", "ABANDONED"}
        or not isinstance(digest, str)
        or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest)
    ):
        return error_response(request_id, -32602, "invalid managed SLP Human decision")
    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if not lease or not workflow.governs(lease, agent_id, role):
            return denied_tool_result(request_id, "target has no active managed SLP lease")
        workspace_id = lease.get("workspace_id")
        workspace_state = (
            workspace_lifecycle(workspace_id)
            if isinstance(workspace_id, str)
            else "unreadable"
        )
        lead_state, lead = agent_record_status(lead_id)
        if workspace_state in {"missing", "archived"} or lead_state in {
            "missing", "archived"
        }:
            lease["state"] = "released"
            lease["released_at"] = utc_timestamp()
            lease["release_reason"] = (
                f"{workspace_state}_workspace_decision_reconciled"
                if workspace_state in {"missing", "archived"}
                else f"{lead_state}_agent_decision_reconciled"
            )
            return denied_tool_result(request_id, "managed SLP authority no longer exists")
        lead_labels = lead.get("labels") if isinstance(lead, dict) else None
        if (
            workspace_state != "active"
            or lead_state != "active"
            or not isinstance(lead_labels, dict)
            or lead_labels.get("role") != "lead"
            or not workflow.lead_matches(lease, lead)
        ):
            return denied_tool_result(request_id, "managed SLP authority is unreadable or invalid")
        epoch = normalize_lease_epoch(lease)
        if not expected_version_matches(
            lease, arguments.get("expectedWorkEpoch"), arguments.get("expectedRevision")
        ):
            return denied_tool_result(request_id, "stale managed SLP epoch or revision")
        if lease.get("human_decision") in {"ACCEPTED", "ABANDONED"}:
            return denied_tool_result(request_id, "Human decision for this work epoch is already recorded")
        if (
            lease.get("decision_state") != "HANDBACK_READY"
            or lease.get("handback_epoch") != epoch
            or lease.get("evidence_digest") != digest
            or (decision == "ACCEPTED" and lease.get("legacy_evidence_missing") is True)
        ):
            return denied_tool_result(request_id, "Human decision evidence does not match the ready epoch")
        if decision == "ACCEPTED":
            verify_candidate(lease, lead)
        correlation_id = str(uuid.uuid4())
        lease["human_decision"] = decision
        lease["human_decision_epoch"] = epoch
        lease["human_decision_evidence_digest"] = digest
        lease["human_decision_at"] = utc_timestamp()
        bump_revision(lease)
        append_history(
            lease, "HUMAN_DECISION", agent_id, "HUMAN" if role == "human" else "HUMAN_VIA_SUPERVISOR",
            correlation_id, decision,
        )
    return text_tool_result(
        request_id, f"Managed SLP epoch {epoch} recorded as {decision} for {digest}."
    )


def archive_slp_workspace(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can archive a managed room")
    required = {"agentId", "expectedWorkEpoch", "expectedRevision"}
    if set(arguments) != required or not isinstance(arguments.get("agentId"), str):
        return error_response(
            request_id, -32602,
            "archive requires agentId, expectedWorkEpoch, and expectedRevision",
        )
    lead_id = arguments["agentId"]
    lead_state, lead = agent_record_status(lead_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None
    if (
        lead_state != "active"
        or not isinstance(labels, dict)
        or labels.get("role") != "lead"
    ):
        return denied_tool_result(request_id, "managed Lead authority is unreadable or inactive")

    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if not lease or not workflow.governs(lease, agent_id, role):
            return denied_tool_result(request_id, "target has no active managed SLP lease")
        if not workflow.lead_matches(lease, lead):
            return denied_tool_result(request_id, "Lead authority binding drifted")
        workspace_id = lease.get("workspace_id")
        if not isinstance(workspace_id, str) or workspace_lifecycle(workspace_id) != "active":
            return denied_tool_result(request_id, "managed workspace authority is unreadable or inactive")
        epoch = normalize_lease_epoch(lease, labels)
        if not expected_version_matches(
            lease, arguments.get("expectedWorkEpoch"), arguments.get("expectedRevision")
        ):
            return denied_tool_result(request_id, "stale managed SLP epoch or revision")
        digest = lease.get("evidence_digest")
        if (
            lease.get("decision_state") != "HANDBACK_READY"
            or lease.get("handback_epoch") != epoch
            or lease.get("human_decision") not in {"ACCEPTED", "ABANDONED"}
            or lease.get("human_decision_epoch") != epoch
            or not isinstance(digest, str)
            or lease.get("human_decision_evidence_digest") != digest
        ):
            return denied_tool_result(request_id, "managed room lacks a current digest-bound Human decision")
        if lease.get("human_decision") == "ACCEPTED":
            verify_candidate(lease, lead)
        correlation_id = str(uuid.uuid4())
        lease["decision_state"] = "ARCHIVE_SENDING"
        lease["delivery_started_at"] = utc_timestamp()
        lease["delivery_correlation_id"] = correlation_id
        reservation_revision = bump_revision(lease)
        append_history(
            lease, "ARCHIVE", agent_id, "HUMAN" if role == "human" else "HUMAN_VIA_SUPERVISOR",
            correlation_id, "RESERVED",
        )

    try:
        response = upstream_call(
            agent_id,
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": "tools/call",
                "params": {
                    "name": "archive_workspace",
                    "arguments": {"workspaceId": workspace_id},
                },
            },
        )
    except Exception:
        with locked_leases() as registry:
            lease = registry["leases"].get(workspace_id)
            if (
                isinstance(lease, dict)
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "ARCHIVE", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        raise
    delivery_status = delivery_response_status(response)
    if delivery_status == "uncertain":
        with locked_leases() as registry:
            lease = registry["leases"].get(workspace_id)
            if (
                isinstance(lease, dict)
                and lease.get("revision") == reservation_revision
                and lease.get("delivery_correlation_id") == correlation_id
            ):
                append_history(
                    lease, "ARCHIVE", agent_id, "TRANSPORT", correlation_id, "UNCERTAIN"
                )
        return text_tool_result(
            request_id,
            "Workspace archive completion is uncertain; it was not retried and requires Human resolution.",
            is_error=True,
        )
    with locked_leases() as registry:
        lease = registry["leases"].get(workspace_id)
        if (
            not isinstance(lease, dict)
            or lease.get("decision_state") != "ARCHIVE_SENDING"
            or lease.get("work_epoch") != epoch
            or lease.get("revision") != reservation_revision
            or lease.get("delivery_correlation_id") != correlation_id
        ):
            return text_tool_result(
                request_id, "Workspace archive response arrived for a stale reservation.", is_error=True
            )
        if delivery_status == "rejected":
            lease["decision_state"] = "HANDBACK_READY"
            result = "REJECTED"
        else:
            lease["state"] = "released"
            lease["decision_state"] = "ARCHIVED"
            lease["release_reason"] = "human_decision_workspace_archived"
            lease["released_at"] = utc_timestamp()
            result = "DELIVERED"
        lease.pop("delivery_started_at", None)
        lease.pop("delivery_correlation_id", None)
        bump_revision(lease)
        append_history(lease, "ARCHIVE", agent_id, "TRANSPORT", correlation_id, result)
    return text_tool_result(
        request_id,
        "Managed workspace archived." if result == "DELIVERED" else "Workspace archive was rejected.",
        is_error=result != "DELIVERED",
    )


def upstream_tool_call(
    caller_id: str,
    request_id: Any,
    name: str,
    arguments: dict[str, Any],
) -> dict[str, Any] | None:
    payload = {
        "jsonrpc": "2.0",
        "id": request_id,
        "method": "tools/call",
        "params": {"name": name, "arguments": arguments},
    }
    response = upstream_call(caller_id, payload)
    if tool_not_available(response):
        response = upstream_call(caller_id, payload, agent_scoped=False)
    return response


def peer_terminal_handback(
    status_payload: dict[str, Any],
    activity_payload: dict[str, Any],
) -> tuple[str, str] | None:
    snapshot = status_payload.get("snapshot")
    pending = snapshot.get("pendingPermissions") if isinstance(snapshot, dict) else None
    content = activity_payload.get("content")
    content = content if isinstance(content, str) else ""
    matches = list(
        re.finditer(
            r"(?m)^Task outcome: (DONE|BLOCKED_PERMISSION|NEEDS_LEAD_DECISION|FAILED)\s*$",
            content,
        )
    )
    status = status_payload.get("status")
    if matches and status in {"idle", "error", "closed"}:
        match = matches[-1]
        return match.group(1), content[match.start():].strip()
    if isinstance(pending, list) and pending:
        return (
            "BLOCKED_PERMISSION",
            "Task outcome: BLOCKED_PERMISSION\n\n"
            "Paseo reports one or more pending permission requests.",
        )
    if status in {"error", "closed"}:
        return (
            "FAILED",
            f"Task outcome: FAILED\n\nPaseo reports terminal agent status {status}.",
        )
    return None


def recover_peer_callbacks(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role != "lead":
        return denied_tool_result(request_id, "only Lead can recover Peer callbacks")
    if arguments:
        return error_response(request_id, -32602, "recover_peer_callbacks takes no arguments")
    lead = load_agent_record(agent_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None
    if (
        not isinstance(lead, dict)
        or lead.get("archivedAt") is not None
        or not isinstance(labels, dict)
        or labels.get("role") != "lead"
        or labels.get("room_kind") != "managed_slp"
    ):
        return denied_tool_result(request_id, "caller is not an active managed Lead")

    with locked_leases() as registry:
        lease = lead_lease(registry, agent_id)
        if not lease or lease.get("decision_state") != "WORKING":
            return denied_tool_result(request_id, "managed Lead is not in a working epoch")
        workspace_id = lease.get("workspace_id")
        epoch = normalize_lease_epoch(lease, labels)
        start_revision = normalize_lease_revision(lease)
        receipts = lease.get("peer_callbacks", {})
        if not isinstance(receipts, dict):
            return denied_tool_result(request_id, "Peer callback registry is invalid; failing closed")
        known_receipts = dict(receipts)

    candidates = []
    for record in iter_agent_records():
        peer_labels = record.get("labels")
        if (
            record.get("archivedAt") is None
            and record.get("workspaceId") == workspace_id
            and isinstance(peer_labels, dict)
            and peer_labels.get("role") == "peer"
            and peer_labels.get("paseo.parent-agent-id") == agent_id
            and peer_labels.get("task_state")
            in PEER_TERMINAL_OUTCOMES | {"ASSIGNED", "REWORK"}
        ):
            peer_epoch = peer_labels.get("work_epoch")
            if peer_labels.get("room_kind") != "managed_slp" or peer_epoch != str(epoch):
                return denied_tool_result(
                    request_id,
                    f"owned Peer {record.get('id')} is not fenced to work epoch {epoch}",
                )
            candidates.append(record)

    callbacks = []
    new_receipts: dict[str, dict[str, Any]] = {}
    for peer in candidates:
        peer_id = peer["id"]
        peer_labels = peer["labels"]
        receipt = known_receipts.get(peer_id)
        if isinstance(receipt, dict):
            if (
                receipt.get("work_epoch") != epoch
                or not isinstance(receipt.get("evidence_digest"), str)
                or receipt.get("outcome") not in PEER_TERMINAL_OUTCOMES
            ):
                return denied_tool_result(
                    request_id, f"Peer callback receipt for {peer_id} is invalid; failing closed"
                )
            if peer_labels.get("task_state") != "REWORK":
                callbacks.append(dict(receipt, agent_id=peer_id, recovered=True))
                continue
        if peer_labels.get("task_state") not in {"ASSIGNED", "REWORK"}:
            continue
        status_response = upstream_tool_call(
            agent_id, request_id, "get_agent_status", {"agentId": peer_id}
        )
        status_payload = structured_content(status_response)
        if status_payload is None:
            return text_tool_result(
                request_id,
                f"Peer status for {peer_id} is unavailable; recovery failed closed.",
                is_error=True,
            )
        activity_response = upstream_tool_call(
            agent_id,
            request_id,
            "get_agent_activity",
            {"agentId": peer_id, "limit": 8},
        )
        activity_payload = structured_content(activity_response)
        if activity_payload is None:
            return text_tool_result(
                request_id,
                f"Peer activity for {peer_id} is unavailable; recovery failed closed.",
                is_error=True,
            )
        terminal = peer_terminal_handback(status_payload, activity_payload)
        if terminal is None:
            continue
        outcome, handback_message = terminal
        update_count = activity_payload.get("updateCount")
        if (
            not isinstance(update_count, int)
            or isinstance(update_count, bool)
            or update_count < 1
        ):
            return text_tool_result(
                request_id,
                f"Peer activity update count for {peer_id} is invalid; recovery failed closed.",
                is_error=True,
            )
        prior_receipt = known_receipts.get(peer_id)
        if (
            isinstance(prior_receipt, dict)
            and peer_labels.get("task_state") == "REWORK"
            and update_count <= prior_receipt.get("activity_update_count", 0)
        ):
            continue
        receipt = {
            "work_epoch": epoch,
            "outcome": outcome,
            "evidence_digest": digest_payload(
                {
                    "agent_id": peer_id,
                    "activity_update_count": update_count,
                    "handback_message": handback_message,
                    "work_epoch": epoch,
                }
            ),
            "activity_update_count": update_count,
            "handback_message": handback_message,
            "recovered_at": utc_timestamp(),
        }
        new_receipts[peer_id] = receipt
        callbacks.append(dict(receipt, agent_id=peer_id, recovered=True))

    if new_receipts:
        with locked_leases() as registry:
            lease = lead_lease(registry, agent_id)
            if (
                not lease
                or lease.get("decision_state") != "WORKING"
                or lease.get("work_epoch") != epoch
                or normalize_lease_revision(lease) != start_revision
            ):
                return text_tool_result(
                    request_id,
                    "Peer callbacks were found but the managed epoch changed; nothing was recorded.",
                    is_error=True,
                )
            stored = lease.setdefault("peer_callbacks", {})
            if not isinstance(stored, dict):
                return denied_tool_result(
                    request_id, "Peer callback registry is invalid; failing closed"
                )
            for peer_id, receipt in new_receipts.items():
                stored[peer_id] = receipt
            bump_revision(lease)
            for peer_id, receipt in new_receipts.items():
                append_history(
                    lease,
                    "PEER_CALLBACK_RECOVERY",
                    agent_id,
                    "LEAD",
                    receipt["evidence_digest"],
                    receipt["outcome"],
                )

        for peer in candidates:
            peer_id = peer["id"]
            receipt = new_receipts.get(peer_id)
            if receipt is None:
                continue
            next_labels = dict(peer["labels"])
            next_labels["task_state"] = receipt["outcome"]
            label_response = upstream_tool_call(
                agent_id,
                request_id,
                "update_agent",
                {"agentId": peer_id, "labels": next_labels},
            )
            if response_is_error(label_response):
                for callback in callbacks:
                    if callback["agent_id"] == peer_id:
                        callback["label_update"] = False
            else:
                for callback in callbacks:
                    if callback["agent_id"] == peer_id:
                        callback["label_update"] = True

    return text_tool_result(
        request_id,
        json.dumps({"callbacks": callbacks}, sort_keys=True),
    )


def inspect_peer_attention(
    agent_id: str, role: str, request_id: Any, arguments: dict[str, Any]
) -> dict[str, Any]:
    if role != "lead":
        return denied_tool_result(request_id, "only the bound Lead may inspect Peer attention")
    if arguments:
        return error_response(request_id, -32602, "inspect_peer_attention takes no arguments")
    with read_locked_leases() as registry:
        authority = _attention_authority(registry, agent_id, agent_id, role)
        if authority is None:
            return denied_tool_result(request_id, "caller has no active working room authority")
        lease, _ = authority
        epoch = lease["work_epoch"]
        revision = normalize_lease_revision(lease)
        workspace_id = lease["workspace_id"]
        callback_receipts = lease.get("peer_callbacks", {})
        if not isinstance(callback_receipts, dict):
            return denied_tool_result(request_id, "Peer callback registry is invalid")
        callback_receipts = dict(callback_receipts)
    candidates = []
    for peer in iter_agent_records():
        labels = peer.get("labels")
        if (
            peer.get("archivedAt") is None
            and peer.get("workspaceId") == workspace_id
            and isinstance(labels, dict)
            and labels.get("role") == "peer"
            and labels.get("room_kind") == "managed_slp"
            and labels.get("paseo.parent-agent-id") == agent_id
            and labels.get("work_epoch") == str(epoch)
            and labels.get("task_state") in {"ASSIGNED", "REWORK"}
        ):
            candidates.append(peer)
    if len(candidates) > 32:
        return denied_tool_result(request_id, "too many current Peer assignments for one bounded inspection")
    signals = []
    for peer in candidates:
        peer_id = peer["id"]
        status = structured_content(upstream_tool_call(
            agent_id, request_id, "get_agent_status", {"agentId": peer_id}
        ))
        activity = structured_content(upstream_tool_call(
            agent_id, request_id, "get_agent_activity", {"agentId": peer_id, "limit": 8}
        ))
        refreshed = load_agent_record(peer_id)
        if refreshed != peer:
            signals.append({"peer_agent_id": peer_id, "signal": "PEER_RECORD_CHANGED"})
            continue
        if status is None or activity is None:
            signals.append({"peer_agent_id": peer_id, "signal": "ACTIVITY_UNAVAILABLE"})
            continue
        prior = callback_receipts.get(peer_id)
        update_count = activity.get("updateCount")
        if (
            peer["labels"].get("task_state") == "REWORK" and isinstance(prior, dict)
            and type(update_count) is int and update_count <= prior.get("activity_update_count", -1)
        ):
            continue
        terminal = peer_terminal_handback(status, activity)
        stale_terminal = (
            peer["labels"].get("task_state") == "REWORK"
            and isinstance(prior, dict)
            and terminal is not None
            and terminal[1] == prior.get("handback_message")
        )
        signal = attention.peer_turn_signal(
            status, activity, has_terminal_handback=terminal is not None and not stale_terminal
        )
        if signal is not None:
            signals.append({
                "peer_agent_id": peer_id,
                "assignment_id": peer["labels"].get("assignment_id"),
                "activity_update_count": update_count,
                "signal": signal,
            })
    with read_locked_leases() as registry:
        authority = _attention_authority(registry, agent_id, agent_id, role)
        if authority is None or authority[0].get("work_epoch") != epoch or normalize_lease_revision(authority[0]) != revision:
            return text_tool_result(request_id, "Managed room changed during attention inspection; retry explicitly.", is_error=True)
    return text_tool_result(
        request_id,
        json.dumps({"work_epoch": epoch, "revision": revision, "signals": signals,
                    "note": "Signals are diagnostic; idle never completes or accepts a Peer assignment."}, sort_keys=True),
    )


def ownership_authority(
    record: dict[str, Any],
    supervisor_id: str,
    lease: dict[str, Any] | None,
) -> dict[str, Any]:
    labels = record.get("labels")
    labels = labels if isinstance(labels, dict) else {}
    workspace_id = record.get("workspaceId")
    workspace_state = (
        workspace_lifecycle(workspace_id) if isinstance(workspace_id, str) else "unreadable"
    )
    active_lease = lease if isinstance(lease, dict) and lease.get("state") == "active" else None
    authority = {
        "agent_id": record.get("id"),
        "workspace_id": workspace_id,
        "provider": record.get("provider"),
        "parent_agent_id": labels.get("paseo.parent-agent-id"),
        "supervisor_agent_id": supervisor_id,
        "workspace_state": workspace_state,
        "archived": record.get("archivedAt") is not None,
        "lease_lead_agent_id": active_lease.get("lead_agent_id") if active_lease else None,
        "lease_revision": active_lease.get("revision", 1) if active_lease else None,
        "lease_decision_state": (
            active_lease.get("decision_state") if active_lease else None
        ),
        "lease_supervisor_agent_id": (
            active_lease.get("supervisor_agent_id") if active_lease else None
        ),
        "legacy_orphan": (
            active_lease.get("legacy_orphan") is True if active_lease else False
        ),
        "room_kind": labels.get("room_kind"),
    }
    return authority


def inspect_slp_ownership(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role != "supervisor":
        return denied_tool_result(request_id, "only Supervisor can inspect SLP ownership")
    if arguments:
        return error_response(request_id, -32602, "inspect_slp_ownership takes no arguments")
    with locked_leases() as registry:
        leases = {
            workspace_id: dict(lease)
            for workspace_id, lease in registry["leases"].items()
            if isinstance(lease, dict)
        }
    candidates = []
    for record in iter_agent_records():
        labels = record.get("labels")
        labels = labels if isinstance(labels, dict) else {}
        if record.get("provider") not in CUSTOM_LEAD_PROVIDERS:
            continue
        workspace_id = record.get("workspaceId")
        lease = leases.get(workspace_id) if isinstance(workspace_id, str) else None
        authority = ownership_authority(record, agent_id, lease)
        managed = (
            isinstance(lease, dict)
            and lease.get("state") == "active"
            and lease.get("room_kind") == "managed_slp"
            and lease.get("lead_agent_id") == record.get("id")
            and lease.get("legacy_orphan") is not True
            and lease.get("supervisor_agent_id") == agent_id
            and workflow.lead_matches(lease, record)
        )
        parent_id = labels.get("paseo.parent-agent-id")
        if authority["archived"]:
            classification = "archived_record"
        elif managed:
            classification = "managed_lease_holder"
        elif not isinstance(parent_id, str) or not parent_id:
            classification = "unparented_orphan"
        elif parent_id != agent_id:
            classification = "foreign_parent"
        else:
            classification = "legacy_orphan"
        candidates.append(
            {
                **authority,
                "classification": classification,
                "authority_digest": digest_payload(authority),
            }
        )
    return text_tool_result(
        request_id, json.dumps({"candidates": candidates}, sort_keys=True)
    )


def retire_legacy_lead(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role != "supervisor":
        return denied_tool_result(request_id, "only Supervisor can retire a legacy Lead")
    required = {"agentId", "workspaceId", "authorityDigest"}
    if set(arguments) != required:
        return error_response(
            request_id,
            -32602,
            "retirement requires agentId, workspaceId, and authorityDigest",
        )
    lead_id = arguments.get("agentId")
    workspace_id = arguments.get("workspaceId")
    expected_digest = arguments.get("authorityDigest")
    if (
        not isinstance(lead_id, str)
        or not isinstance(workspace_id, str)
        or not isinstance(expected_digest, str)
    ):
        return error_response(request_id, -32602, "invalid legacy Lead retirement fence")
    record_state, lead = agent_record_status(lead_id)
    if record_state != "active" or not isinstance(lead, dict):
        return denied_tool_result(request_id, "legacy Lead is not an active persisted record")
    labels = lead.get("labels")
    labels = labels if isinstance(labels, dict) else {}
    if (
        lead.get("provider") not in CUSTOM_LEAD_PROVIDERS
        or lead.get("workspaceId") != workspace_id
        or labels.get("paseo.parent-agent-id") != agent_id
    ):
        return denied_tool_result(
            request_id, "legacy Lead does not match caller parentage and workspace authority"
        )
    with locked_leases() as registry:
        lease = registry["leases"].get(workspace_id)
        lease = dict(lease) if isinstance(lease, dict) else None
    authority = ownership_authority(lead, agent_id, lease)
    if digest_payload(authority) != expected_digest:
        return denied_tool_result(request_id, "stale legacy Lead authority digest")
    if authority["workspace_state"] not in {"active", "archived"}:
        return denied_tool_result(request_id, "legacy Lead workspace authority is unreadable")
    if (
        isinstance(lease, dict)
        and lease.get("state") == "active"
        and lease.get("room_kind") == "managed_slp"
        and lease.get("lead_agent_id") == lead_id
        and lease.get("legacy_orphan") is not True
    ):
        return denied_tool_result(
            request_id, "target is the managed lease holder; use protected managed lifecycle"
        )

    correlation_id = str(uuid.uuid4())
    history_authority = {
        "work_epoch": lease.get("work_epoch") if isinstance(lease, dict) else None,
        "revision": lease.get("revision", 1) if isinstance(lease, dict) else 1,
    }
    append_history(
        history_authority,
        "LEGACY_LEAD_RETIRE",
        agent_id,
        "HUMAN_VIA_SUPERVISOR",
        correlation_id,
        "RESERVED",
    )
    response = upstream_tool_call(
        agent_id, request_id, "archive_agent", {"agentId": lead_id}
    )
    delivery_status = delivery_response_status(response)
    result = (
        "DELIVERED"
        if delivery_status == "delivered"
        else "REJECTED"
        if delivery_status == "rejected"
        else "UNCERTAIN"
    )
    append_history(
        history_authority,
        "LEGACY_LEAD_RETIRE",
        agent_id,
        "TRANSPORT",
        correlation_id,
        result,
    )
    if result != "DELIVERED":
        return text_tool_result(
            request_id,
            "Legacy Lead retirement was rejected."
            if result == "REJECTED"
            else "Legacy Lead retirement is uncertain; inspect persisted agent authority before any retry.",
            is_error=True,
        )
    if (
        isinstance(lease, dict)
        and lease.get("state") == "active"
        and lease.get("lead_agent_id") == lead_id
        and lease.get("legacy_orphan") is True
    ):
        with locked_leases() as registry:
            stored = registry["leases"].get(workspace_id)
            if (
                not isinstance(stored, dict)
                or stored.get("state") != "active"
                or stored.get("lead_agent_id") != lead_id
                or stored.get("legacy_orphan") is not True
                or digest_payload(ownership_authority(lead, agent_id, stored))
                != expected_digest
            ):
                return text_tool_result(
                    request_id,
                    "Legacy Lead was archived but its cleanup fence changed unexpectedly.",
                    is_error=True,
                )
            stored["state"] = "released"
            stored["decision_state"] = "LEGACY_RETIRED"
            stored["released_at"] = utc_timestamp()
            stored["release_reason"] = "legacy_lead_soft_archived"
            bump_revision(stored)
    return text_tool_result(
        request_id,
        f"Legacy Lead {lead_id} was soft-archived with authority digest {expected_digest}.",
    )


def recover_working_lead(
    agent_id: str,
    role: str,
    request_id: Any,
    arguments: dict[str, Any],
) -> dict[str, Any]:
    if role not in {"supervisor", "human"}:
        return denied_tool_result(request_id, "only Supervisor can recover a working Lead")
    if set(arguments) != {"agentId", "prompt"}:
        return error_response(request_id, -32602, "recovery requires agentId and prompt")
    lead_id = arguments.get("agentId")
    prompt = arguments.get("prompt")
    if not isinstance(lead_id, str) or not isinstance(prompt, str) or not prompt.strip():
        return error_response(request_id, -32602, "recovery target and prompt must be non-empty")

    lead = load_agent_record(lead_id)
    labels = lead.get("labels") if isinstance(lead, dict) else None
    if (
        not isinstance(lead, dict)
        or lead.get("archivedAt") is not None
        or not isinstance(labels, dict)
        or labels.get("role") != "lead"
        or labels.get("room_kind") != "managed_slp"
        or labels.get("task_state") != "LEASED"
    ):
        return denied_tool_result(request_id, "target is not this Supervisor's active leased Lead")

    with locked_leases() as registry:
        lease = lead_lease(registry, lead_id)
        if lease and not workflow.lead_matches(lease, lead):
            return denied_tool_result(request_id, "Lead authority binding drifted")
        if (
            not lease
            or lease.get("state") != "active"
            or lease.get("decision_state") != "WORKING"
            or not workflow.governs(lease, agent_id, role)
        ):
            return denied_tool_result(request_id, "managed Lead is not in recoverable WORKING state")
        correlation_id = str(uuid.uuid4())
        append_history(
            lease, "RECOVER", agent_id, "HUMAN" if role == "human" else "HUMAN_VIA_SUPERVISOR",
            correlation_id, "REQUESTED",
        )

    response = upstream_call(
        agent_id,
        {
            "jsonrpc": "2.0",
            "id": request_id,
            "method": "tools/call",
            "params": {
                "name": "send_agent_prompt",
                "arguments": {
                    "agentId": lead_id,
                    "prompt": prompt.strip(),
                    "background": True,
                    "notifyOnFinish": False,
                },
            },
        },
    )
    if response is None:
        return error_response(request_id, -32603, "Lead recovery returned no response")
    return response


def call_tool(
    agent_id: str,
    role: str,
    request_id: Any,
    params: dict[str, Any],
) -> dict[str, Any]:
    name = params.get("name")
    arguments = params.get("arguments", {})
    if not isinstance(name, str) or not isinstance(arguments, dict):
        return error_response(request_id, -32602, "tools/call requires name and object arguments")
    if role == "lead":
        with locked_leases() as registry:
            lease = lead_lease(registry, agent_id)
            record = load_agent_record(agent_id)
            if lease and record:
                workflow.verify_context(lease, record, pin=True)
    if name == WORK_CONTEXT_TOOL["name"]:
        return inspect_work_context(agent_id, role, request_id, arguments)
    if name == WORK_CANDIDATE_TOOL["name"]:
        return inspect_work_context(agent_id, role, request_id, arguments, candidate=True)
    if name == PEER_REPORT_TOOL["name"]:
        return record_peer_report(agent_id, role, request_id, arguments)
    if name == OPEN_ROOM_ASK_TOOL["name"]:
        return open_room_ask(agent_id, role, request_id, arguments)
    if name == ANSWER_ROOM_ASK_TOOL["name"]:
        return answer_room_ask(agent_id, role, request_id, arguments)
    if name == LIST_ROOM_ATTENTION_TOOL["name"]:
        return list_room_attention(agent_id, role, request_id, arguments)
    if name == INSPECT_PEER_ATTENTION_TOOL["name"]:
        return inspect_peer_attention(agent_id, role, request_id, arguments)
    if name in {HAND_BACK_TOOL["name"], SUBMIT_RESULT_TOOL["name"]}:
        return handback_to_parent(agent_id, role, request_id, arguments)
    if name == LIST_SLP_DECISIONS_TOOL["name"]:
        return list_slp_decisions(agent_id, role, request_id, arguments)
    if name == REOPEN_WORK_EPOCH_TOOL["name"]:
        return reopen_work_epoch(agent_id, role, request_id, arguments)
    if name == RESOLVE_SLP_DELIVERY_TOOL["name"]:
        return resolve_slp_delivery(agent_id, role, request_id, arguments)
    if name == RECORD_SLP_DECISION_TOOL["name"]:
        return record_slp_decision(agent_id, role, request_id, arguments)
    if name == ARCHIVE_SLP_WORKSPACE_TOOL["name"]:
        return archive_slp_workspace(agent_id, role, request_id, arguments)
    if name == RECOVER_WORKING_LEAD_TOOL["name"]:
        return recover_working_lead(agent_id, role, request_id, arguments)
    if name == RECOVER_PEER_CALLBACKS_TOOL["name"]:
        return recover_peer_callbacks(agent_id, role, request_id, arguments)
    if name == INSPECT_SLP_OWNERSHIP_TOOL["name"]:
        return inspect_slp_ownership(agent_id, role, request_id, arguments)
    if name == RETIRE_LEGACY_LEAD_TOOL["name"]:
        return retire_legacy_lead(agent_id, role, request_id, arguments)
    if not allowed_tool(role, name):
        return denied_tool_result(request_id, f"{role} cannot call Paseo tool {name}")

    tool_use_id = f"proxy-{uuid.uuid4()}"
    allowed, reason, guarded_arguments = run_guard(
        role,
        "PreToolUse",
        agent_id,
        name,
        arguments,
        tool_use_id,
    )
    if not allowed:
        return denied_tool_result(request_id, reason or "denied")

    payload = {
        "jsonrpc": "2.0",
        "id": request_id,
        "method": "tools/call",
        "params": {"name": name, "arguments": guarded_arguments},
    }
    response = upstream_call(
        agent_id,
        payload,
    )
    if tool_not_available(response):
        fallback_arguments = unscoped_arguments(agent_id, name, guarded_arguments)
        response = upstream_call(
            agent_id,
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": "tools/call",
                "params": {"name": name, "arguments": fallback_arguments},
            },
            agent_scoped=False,
        )
    if response is None:
        response = error_response(request_id, -32603, "Paseo MCP returned no response")
    run_guard(
        role,
        "PostToolUse",
        agent_id,
        name,
        guarded_arguments,
        tool_use_id,
        response,
    )
    return response


def handle(agent_id: str, role: str, request: dict[str, Any]) -> dict[str, Any] | None:
    method = request.get("method")
    request_id = request.get("id")
    if method == "initialize":
        params = request.get("params")
        version = params.get("protocolVersion") if isinstance(params, dict) else None
        return {
            "jsonrpc": "2.0",
            "id": request_id,
            "result": {
                "protocolVersion": version or "2025-06-18",
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": f"paseo-room-{role}", "version": "1.3.0"},
            },
        }
    if method == "notifications/initialized":
        return None
    if method == "ping":
        return {"jsonrpc": "2.0", "id": request_id, "result": {}}
    # Paseo probes ACP catalogs before an agent exists. Let that anonymous,
    # read-only probe initialize OpenCode without exposing any control tools.
    # Real room sessions still require a resolvable Paseo agent identity.
    if not agent_id and method == "tools/list":
        return {"jsonrpc": "2.0", "id": request_id, "result": {"tools": []}}
    if not agent_id and method == "tools/call":
        return denied_tool_result(request_id, "PASEO_AGENT_ID is required")
    if method == "tools/list":
        return list_tools(agent_id, role, request_id)
    if method == "tools/call":
        params = request.get("params")
        if not isinstance(params, dict):
            return error_response(request_id, -32602, "tools/call params must be an object")
        return call_tool(agent_id, role, request_id, params)
    if request_id is None:
        return None
    return error_response(request_id, -32601, f"Method not found: {method}")


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in {"supervisor", "lead", "peer"}:
        fail("usage: paseo-room-mcp supervisor|lead|peer")
    role = sys.argv[1]
    agent_id = resolve_agent_id()
    while True:
        request = read_message()
        if request is None:
            return
        try:
            response = handle(agent_id, role, request)
        except Exception as error:
            response = error_response(request.get("id"), -32603, str(error))
        if response is not None:
            write_message(response)


if __name__ == "__main__":
    main()
