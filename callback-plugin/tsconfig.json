{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["node"], "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true
  },
  "include": ["index.server.ts", "server/**/*.ts", "test/**/*.ts"]
}
