{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "enabled": true,
      "injectIntoAgents": false
    },
    "browserTools": {
      "enabled": true
    },
    "autoArchiveAfterMerge": false,
    "enableTerminalAgentHooks": true,
    "appendSystemPrompt": "",
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "omp": {
        "enabled": false
      },
      "pi": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "claude": {
        "enabled": true
      },
      "claude-supervisor": {
        "paseoTools": {
          "enabled": false
        },
        "extends": "claude",
        "label": "Claude Opus Supervisor",
        "description": "Human-facing governance Supervisor using Claude Opus",
        "command": [
          "{{HOME}}/.local/bin/claude-room",
          "supervisor"
        ],
        "env": {
          "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
          "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
        },
        "disallowedTools": [
          "Agent",
          "Task",
          "Workflow"
        ],
        "models": [
          {
            "id": "claude-opus-5-5",
            "label": "Opus 5.5",
            "isDefault": true,
            "contextWindowMaxTokens": 1000000,
            "thinkingOptions": [
              {
                "id": "xhigh",
                "label": "XHigh",
                "isDefault": true
              }
            ]
          }
        ]
      },
      "codex-supervisor": {
        "paseoTools": {
          "enabled": false
        },
        "extends": "codex",
        "label": "Codex Supervisor",
        "description": "Project-owner assistant for cross-workspace supervision and operations",
        "command": [
          "{{HOME}}/.local/bin/codex-room",
          "supervisor"
        ],
        "models": [
          {
            "id": "gpt-6-sol",
            "label": "GPT-6 Sol",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "xhigh",
                "label": "XHigh",
                "isDefault": true
              }
            ]
          }
        ]
      },
      "codex-lead": {
        "paseoTools": {
