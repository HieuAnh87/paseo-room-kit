{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "{{HOME}}/.config/opencode/paseo-supervisor.instructions.md"
  ],
  "permission": {
    "task": "deny",
    "paseo_*": "allow",
    "bash": {
      "*": "allow",
      "paseo *": "deny",
      "*/paseo *": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": "deny",
        "paseo_*": "allow",
        "bash": {
          "*": "allow",
          "paseo *": "deny",
          "*/paseo *": "deny"
        }
      }
    },
    "plan": {
      "permission": {
        "task": "deny",
        "paseo_*": "allow",
        "bash": {
          "*": "allow",
          "paseo *": "deny",
          "*/paseo *": "deny"
        }
      }
    }
  },
  "mcp": {
    "paseo": {
      "type": "local",
      "command": [
        "{{HOME}}/.local/bin/paseo-room-mcp",
        "supervisor"
      ],
      "enabled": true,
      "environment": {
        "PASEO_ROOM_ROLE": "supervisor"
      }
    }
  }
}
