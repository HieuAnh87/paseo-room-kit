{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Agent",
      "Task",
      "Edit",
      "Write",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.codex/hooks/room-role-guard.py --role peer",
            "timeout": 10,
            "statusMessage": "Checking Paseo Reviewer authority..."
          }
        ]
      }
    ]
  }
}
