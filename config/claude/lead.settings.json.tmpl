{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "permissions": {
    "deny": [
      "Agent",
      "Task"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HOME}}/.codex/hooks/room-role-guard.py --role lead",
            "timeout": 10,
            "statusMessage": "Checking Paseo Lead authority..."
          }
        ]
      }
    ]
  }
}
